#!/usr/bin/env bash

# freeram - Linux page-cache cleaner with dry-run and history support.

set -uo pipefail

VERSION="2.1.0"
LOG="${LOG:-/var/log/freeram.log}"
HISTORY="${HISTORY:-/var/lib/freeram/history}"
MEMINFO="${FREERAM_MEMINFO:-/proc/meminfo}"
DROP_CACHES="${FREERAM_DROP_CACHES:-/proc/sys/vm/drop_caches}"
EFFECTIVE_UID="${FREERAM_EUID:-$EUID}"
DATA_DIR="$(dirname "$HISTORY")"

AUTO_YES=false
SILENT=false
TEST_MODE=false
STATS=false

error() { printf 'freeram: %s\n' "$*" >&2; }
warn() { printf 'freeram: warning: %s\n' "$*" >&2; }
emit() { [[ "$SILENT" == "true" ]] || printf '%s\n' "$*"; }

show_help() {
  cat <<EOF
freeram $VERSION - Linux page-cache cleaner

Usage: freeram [OPTIONS]

Options:
  -y, --yes      Skip confirmation before clearing caches
  -s, --silent   Suppress normal output (requires --yes for cleaning)
  -t, --test     Dry run; show what would be done without clearing caches
      --stats    Show current memory statistics and recent history
  -h, --help     Show this help
  -v, --version  Show version

Only an actual cache-cleaning run requires root privileges.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes) AUTO_YES=true ;;
    -s|--silent) SILENT=true ;;
    -t|--test) TEST_MODE=true ;;
    --stats) STATS=true ;;
    -h|--help) show_help; exit 0 ;;
    -v|--version) printf 'freeram %s\n' "$VERSION"; exit 0 ;;
    --) shift; [[ $# -eq 0 ]] || { error "Unexpected argument: $1"; exit 2; }; break ;;
    -*) error "Unknown option: $1"; error "Try 'freeram --help' for usage."; exit 2 ;;
    *) error "Unexpected argument: $1"; error "Try 'freeram --help' for usage."; exit 2 ;;
  esac
  shift
done

command -v awk >/dev/null 2>&1 || { error "Required command not found: awk"; exit 1; }

read_memory() {
  [[ -r "$MEMINFO" ]] || { error "Cannot read memory information from $MEMINFO"; return 1; }

  mem_free=$(awk '/^MemFree:/ {print int($2/1024); found=1; exit} END {if (!found) exit 1}' "$MEMINFO") || {
    error "Cannot read memory information: MemFree is missing from $MEMINFO"
    return 1
  }

  mem_cached=$(awk '
    /^Cached:/ {cached=$2}
    /^SReclaimable:/ {reclaimable=$2}
    /^Shmem:/ {shmem=$2}
    END {
      if (cached == "") exit 1
      value=cached + reclaimable - shmem
      if (value < 0) value=0
      print int(value/1024)
    }
  ' "$MEMINFO") || {
    error "Cannot read memory information: Cached is missing from $MEMINFO"
    return 1
  }
}

show_stats() {
  read_memory || exit 1

  printf 'Memory Statistics\n'
  printf '=================\n'
  printf 'Current Free: %s MiB\n' "$mem_free"
  printf 'Reclaimable Cache: %s MiB\n\n' "$mem_cached"

  if [[ -f "$HISTORY" ]]; then
    printf 'Recent History (last 5 runs):\n'
    if command -v tail >/dev/null 2>&1; then
      tail -n 5 "$HISTORY" 2>/dev/null || warn "Could not read history from $HISTORY"
    else
      warn "tail is unavailable; recent history cannot be displayed"
    fi
    printf '\nTotal Freed (recorded):\n'
    awk '{sum += $NF} END {printf "%d MiB\n", sum + 0}' "$HISTORY" 2>/dev/null || warn "Could not summarize history from $HISTORY"
  else
    printf 'No history yet. Run freeram to start tracking.\n'
  fi
}

if [[ "$STATS" == "true" ]]; then
  show_stats
  exit 0
fi

read_memory || exit 1

if [[ "$TEST_MODE" == "true" ]]; then
  emit "[TEST MODE] Would clear Linux page caches. Free=${mem_free} MiB, reclaimable cache=${mem_cached} MiB"
  exit 0
fi

if [[ "$SILENT" == "true" && "$AUTO_YES" != "true" ]]; then
  error "Silent mode requires --yes to avoid an unattended confirmation prompt."
  exit 2
fi

if [[ "$EFFECTIVE_UID" != "0" ]]; then
  error "Cache cleaning requires root privileges. Re-run with sudo, or use --test/--stats without sudo."
  exit 1
fi

emit "Free: ${mem_free} MiB, reclaimable cache: ${mem_cached} MiB"

if [[ "$AUTO_YES" != "true" ]]; then
  if [[ ! -t 0 ]]; then
    error "Confirmation requires an interactive terminal; use --yes for automation."
    exit 2
  fi
  read -r -p "Clear Linux page caches? [y/N]: " reply
  [[ "$reply" =~ ^[Yy]$ ]] || { emit "Cancelled"; exit 0; }
fi

[[ -e "$DROP_CACHES" ]] || { error "Cache control file does not exist: $DROP_CACHES"; exit 1; }
[[ -w "$DROP_CACHES" ]] || { error "Cache control file is not writable: $DROP_CACHES"; exit 1; }
command -v sync >/dev/null 2>&1 || { error "Required command not found: sync"; exit 1; }

mem_before_free="$mem_free"

sync || { error "Failed to sync pending filesystem writes; caches were not dropped."; exit 1; }
if ! printf '3\n' >"$DROP_CACHES"; then
  error "Failed to drop caches via $DROP_CACHES"
  exit 1
fi

read_memory || { error "Caches were dropped, but post-clean memory statistics could not be read."; exit 1; }
mem_after="$mem_free"
freed=$((mem_after - mem_before_free))
if (( freed < 0 )); then
  warn "MemFree decreased during measurement; recording 0 MiB freed instead of a negative value."
  freed=0
fi

timestamp=""
if command -v date >/dev/null 2>&1; then
  timestamp="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)"
fi
[[ -n "$timestamp" ]] || timestamp="unknown-time"

if command -v mkdir >/dev/null 2>&1 && mkdir -p "$DATA_DIR" 2>/dev/null; then
  if ! printf '%s %s %s %s\n' "$timestamp" "$mem_before_free" "$mem_after" "$freed" >>"$HISTORY" 2>/dev/null; then
    warn "Could not append history to $HISTORY"
  fi
else
  warn "Could not create history directory $DATA_DIR; history was not recorded"
fi

if ! printf '%s - Freed %s MiB (MemFree %s -> %s MiB)\n' "$timestamp" "$freed" "$mem_before_free" "$mem_after" >>"$LOG" 2>/dev/null; then
  warn "Could not append activity log to $LOG"
fi

emit "Freed ${freed} MiB. Now free: ${mem_after} MiB"
