#!/usr/bin/env bash

# freeram - Fast RAM Cache Cleaner
# No external dependencies - pure bash
# Usage: sudo freeram [OPTIONS]

VERSION="2.0.0"
LOG="${LOG:-/var/log/freeram.log}"
HISTORY="${HISTORY:-/var/lib/freeram/history}"
DATA_DIR="$(dirname "$HISTORY")"

# Defaults
SILENT=false
TEST_MODE=false
STATS=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    -y|--yes) AUTO_YES=true; shift ;;
    -s|--silent) SILENT=true; shift ;;
    -t|--test) TEST_MODE=true; shift ;;
    --stats) STATS=true; shift ;;
    -h|--help)
      echo "freeram $VERSION - Fast RAM Cache Cleaner"
      echo ""
      echo "Usage: sudo freeram [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  -y, --yes    Skip confirmation"
      echo "  -s, --silent  Silent mode (no output)"
      echo "  -t, --test    Test mode (dry run)"
      echo "  --stats       Show statistics"
      echo "  -h, --help    Show this help"
      echo "  -v, --version Show version"
      exit 0
      ;;
    -v|--version) echo "freeram $VERSION"; exit 0 ;;
    *) shift ;;
  esac
done

# Root check
[[ $EUID -eq 0 ]] || { echo "Run as root" >&2; exit 1; }

# Detect distribution
detect_distro() {
  if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    echo "$ID"
  elif [[ -f /etc/redhat-release ]]; then
    echo "rhel"
  elif [[ -f /etc/arch-release ]]; then
    echo "arch"
  elif [[ -f /etc/debian_version ]]; then
    echo "debian"
  else
    echo "unknown"
  fi
}

# Get memory stats (distribution-aware)
get_memory() {
  local distro="$1"
  case "$distro" in
    ubuntu|debian|linuxmint|pop)
      awk '/^(MemFree|Cached):/ {print $2}' /proc/meminfo
      ;;
    fedora|rhel|centos)
      awk '/^(MemFree|Buffers|Cached):/ {print $2}' /proc/meminfo
      ;;
    arch|manjaro)
      awk '/^(MemFree|Cached):/ {print $2}' /proc/meminfo
      ;;
    *)
      awk '/^(MemFree|Cached):/ {print $2}' /proc/meminfo
      ;;
  esac
}

# Read memory stats
mem_free=$(awk '/^MemFree:/ {print int($2/1024)}' /proc/meminfo)
mem_cached=$(awk '/^Cached:/ {print int($2/1024)}' /proc/meminfo)

# Show statistics
show_stats() {
  echo "Memory Statistics"
  echo "================="
  echo "Current Free: ${mem_free} MiB"
  echo "Current Cached: ${mem_cached} MiB"
  echo ""
  
  if [[ -f "$HISTORY" ]]; then
    echo "Recent History (last 5 runs):"
    tail -5 "$HISTORY" 2>/dev/null || echo "No history available"
    echo ""
    
    echo "Total Freed (all time):"
    awk '{sum+=$NF} END {print sum " MiB"}' "$HISTORY" 2>/dev/null || echo "0 MiB"
  else
    echo "No history yet. Run freeram to start tracking."
  fi
  exit 0
}

# Show stats if requested
[[ "$STATS" == "true" ]] && show_stats

# Silent mode - skip all output
[[ "$SILENT" == "true" ]] && {
  [[ "$AUTO_YES" != "true" ]] && { echo "Use -y with -s for silent mode" >&2; exit 1; }
} || {
  echo "Free: ${mem_free} MiB, Cached: ${mem_cached} MiB"
}

# Test mode - dry run
[[ "$TEST_MODE" == "true" ]] && {
  echo "[TEST MODE] Would clear cache. Memory: Free=${mem_free} MiB, Cached=${mem_cached} MiB"
  exit 0
}

# Confirmation
if [[ "$AUTO_YES" != "true" ]] && [[ "$SILENT" != "true" ]]; then
  read -p "Clear cache? (y/n): " -n 1; echo
  [[ ! $REPLY =~ ^[Yy] ]] && { echo "Cancelled"; exit 0; }
fi

# Create data directory
mkdir -p "$DATA_DIR" 2>/dev/null || true

# Drop caches
echo 3 >/proc/sys/vm/drop_caches

# Calculate freed memory
mem_after=$(awk '/^MemFree:/ {print int($2/1024)}' /proc/meminfo)
freed=$((mem_after - mem_free))

# Log to history
mkdir -p "$DATA_DIR"
echo "$(date '+%Y-%m-%d %H:%M:%S') ${mem_free} ${mem_after} ${freed}" >> "$HISTORY" 2>/dev/null || true

# Log to system log
echo "$(date '+%Y-%m-%d %H:%M:%S') - Freed ${freed} MiB" >> "$LOG"

# Output result
[[ "$SILENT" != "true" ]] && echo "Freed ${freed} MiB. Now free: ${mem_after} MiB"
